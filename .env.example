# ═════════════════════════════════════════════════════════════
# Smart Issiqxona - Environment Variables Shablon
# Haqiqiy maxfiy kalitlarni bu yerga EMAS, .env fayliga yozing!
# ═════════════════════════════════════════════════════════════

# 1. ESP32 / ESP8266 Xavfsizlik Kaliti (Vercel Backend va ESP da bir xil bo'lishi shart)
DEVICE_API_KEY=your_secure_device_api_key_here

# 2. Upstash Redis (Serverless Persistence - Tavsiya etiladi)
# Vercel Serverless xotirani saqlash uchun: https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# 3. Mahalliy Rejim (Faqat bitta WiFi da test qilish uchun - bo'sh qoldirilsa Vercel Cloud ishlaydi)
VITE_ESP8266_IP=
VITE_ESP8266_NGROK=
